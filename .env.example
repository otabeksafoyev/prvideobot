# --- Majburiy ---
BOT_TOKEN=123456:ABC-DEF
# Vergul bilan ajrating. O'z ID'ingizni botga /id yuborib bilib oling
ADMIN_IDS=123456789
# Ruxsat etilgan domen(lar) (vergul bilan). Faqat shu domenlardagi havolalar qabul qilinadi
ALLOWED_HOSTS=example.com

# --- Ixtiyoriy ---
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT=2
# Oddiy Bot API limiti 50 MB. Lokal Bot API server bo'lsa 2000 gacha qo'ying
MAX_UPLOAD_MB=50
# Lokal Bot API server manzili (katta fayllar uchun), masalan http://localhost:8081
LOCAL_API_URL=
# Windows'da ffmpeg PATH'da bo'lmasa: C:\ffmpeg\bin
FFMPEG_LOCATION=
LOG_LEVEL=INFO

# Saytga so'rovlarni proksi orqali yuborish (ixtiyoriy). Masalan:
# socks5://login:parol@host:1080   yoki   http://login:parol@host:8080
YTDLP_PROXY=

# 50 MB dan katta videolar uchun (2 GB gacha). my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
