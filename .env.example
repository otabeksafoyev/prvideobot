# --- Majburiy ---
BOT_TOKEN=123456:ABC-DEF
# Vergul bilan ajrating. O'z ID'ingizni botga /id yuborib bilib oling
ADMIN_IDS=123456789
# Ruxsat etilgan domen(lar) (vergul bilan). Faqat shu domenlardagi havolalar qabul qilinadi
ALLOWED_HOSTS=example.com

# --- Ixtiyoriy ---
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT=2
# Oddiy Bot API limiti 50 MB. Lokal Bot API server bo'lsa 2000 gacha qo'ying
MAX_UPLOAD_MB=50
# Lokal Bot API server manzili (katta fayllar uchun), masalan http://localhost:8081
LOCAL_API_URL=
# Windows'da ffmpeg PATH'da bo'lmasa: C:\ffmpeg\bin
FFMPEG_LOCATION=
LOG_LEVEL=INFO

# Saytga so'rovlarni proksi orqali yuborish (ixtiyoriy). Masalan:
# socks5://login:parol@host:1080   yoki   http://login:parol@host:8080
YTDLP_PROXY=

# Eng yuqori sifat (balandlik). 1080 = maksimum; 720 trafikni ~40% kamaytiradi
MAX_HEIGHT=1080
# Oylik chiqish trafigi limiti, GB (0 = cheklanmagan)
MONTHLY_LIMIT_GB=50
# Kodlar va statistika saqlanadigan papka (Railway'da Volume ulang: /data)
DATA_DIR=./data
# Telegramga parallel yuklash oqimlari soni (1-16)
UPLOAD_WORKERS=8

# To'lov cheklari tushadigan kanal va videolar tashlanadigan kanal (bot ikkalasida admin bo'lsin)
PAYMENT_CHANNEL_ID=-1003525618102
VIDEO_CHANNEL_ID=-1004343251790
# Obuna uchun to'lov kartasi (foydalanuvchiga ko'rsatiladi)
CARD_NUMBER=
CARD_OWNER=

# 50 MB dan katta videolar uchun (2 GB gacha). my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
